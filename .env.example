DATABASE_URL="file:./dev.db"
# Öffentliche Adresse der App (für Anmelde-Links, iCal-URL); mit https:// im Betrieb
APP_URL="http://localhost:3000"

# Docker/Caddy
DOMAIN=dorfplaner.example.de

# E-Mail-Versand für Anmelde-Links (optional; ohne SMTP landet der Link im Server-Log,
# Einladungscodes funktionieren immer):  smtp://user:pass@mail.example.de:587
SMTP_URL=
SMTP_FROM="Dorfplaner <dorfplaner@example.de>"

# Push-Benachrichtigungen (optional). Schlüssel erzeugen: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:orga@example.de"

# E-Mail-Adresse der Gemeinde für „Anliegen weiterleiten“ (optional; öffnet eine vorbereitete E-Mail)
MUNICIPALITY_EMAIL=

# Hosts, von denen Müll-Kalender automatisch abgerufen werden dürfen (Standard: AWS Schaumburg)
# WASTE_ALLOWED_HOSTS=kundenlogin.aws-shg.de

# Geheimnis für den täglichen Erinnerungs-Aufruf (/api/cron/reminders), z. B. openssl rand -hex 24
CRON_SECRET=
