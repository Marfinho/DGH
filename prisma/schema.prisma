generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Status als String (SQLite kennt keine Enums); Werte siehe src/lib/constants.ts
model Person {
  id              Int                @id @default(autoincrement())
  name            String
  email           String?            @unique
  phone           String?
  role            String             @default("BEWOHNER") // BEWOHNER | ORGANISATOR | ADMIN
  calToken        String?            @unique // geheimer Token für den iCal-Feed
  createdAt       DateTime           @default(now())
  lastLoginAt     DateTime?
  tasks           Task[]
  sessions        Session[]
  invites         Invite[]
  loginTokens     LoginToken[]
  signups         HelperSignup[]
  rsvps           Rsvp[]
  eventMembers    EventMember[]
  requestedItems  BudgetItem[]       @relation("requested")
  decidedItems    BudgetItem[]       @relation("decided")
  pushSubs        PushSubscription[]
  newsPosts       NewsPost[]
  areas           Area[]
  attachments     Attachment[]
  wastePush       Boolean            @default(false) // Müll-Erinnerung am Vorabend
  wasteTypes      String? // kommagetrennt; leer = alle
  groupMembers    GroupMember[]
  boardPosts      BoardPost[]
  issues          Issue[]
  group           Group?             @relation(fields: [groupId], references: [id])
  groupId         Int?
  polls           Poll[]
  pollVotes       PollVote[]
  bookings        Booking[]          @relation("booker")
  decidedBookings Booking[]          @relation("bookingDecider")
  scheduleItems   ScheduleItem[]
  materialItems   MaterialItem[]
  meetingInvites  MeetingInvitee[]
  meetingTodos    MeetingTodo[]
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  personId  Int
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Invite {
  id        Int       @id @default(autoincrement())
  codeHash  String    @unique
  personId  Int
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model LoginToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  personId  Int
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
}

model HelperSlot {
  id          Int            @id @default(autoincrement())
  eventId     Int
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  timeText    String? // z. B. "14:00–16:00"
  description String?
  capacity    Int            @default(1)
  signups     HelperSignup[]
}

model HelperSignup {
  id        Int        @id @default(autoincrement())
  slotId    Int
  slot      HelperSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  personId  Int
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([slotId, personId])
}

model Rsvp {
  id       Int    @id @default(autoincrement())
  eventId  Int
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId Int
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  status   String // JA | NEIN | VIELLEICHT
  guests   Int    @default(0)

  @@unique([eventId, personId])
}

model PushSubscription {
  id       Int    @id @default(autoincrement())
  personId Int
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String
}

model NewsPost {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  pinned      Boolean  @default(false)
  authorId    Int?
  author      Person?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  groupId     Int?
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  publishedAt DateTime @default(now())
}

model Group {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  meetingInfo String? // z. B. "jeden 1. Dienstag, 19:30, Gemeindehaus"
  website     String?
  contacts    Contact[]
  members     GroupMember[]
  events      Event[]
  news        NewsPost[]
  people      Person[]
}

// Bewusst veröffentlichte Ansprechpartner (getrennt von Person/Login-Konten)
model Contact {
  id       Int     @id @default(autoincrement())
  name     String
  function String? // z. B. "Ortsvorsteher"
  phone    String?
  email    String?
  groupId  Int?
  group    Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  sort     Int     @default(0)
}

model WasteDate {
  id       Int          @id @default(autoincrement())
  type     String // frei, z. B. Restmüll, Bio, Papier, Gelber Sack
  date     DateTime
  sourceId Int? // gesetzt = automatisch aus einer Quelle (z. B. AWS Schaumburg) synchronisiert
  source   WasteSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([type, date])
}

model Template {
  id          Int                    @id @default(autoincrement())
  name        String
  description String?
  updatedAt   DateTime               @updatedAt
  milestones  TemplateMilestone[]
  tasks       TemplateTask[]
  events      Event[]
  budgetItems TemplateBudgetItem[]
  areas       TemplateArea[]
  slots       TemplateSlot[]
  schedule    TemplateScheduleItem[]
  material    TemplateMaterialItem[]
}

model TemplateMilestone {
  id         Int            @id @default(autoincrement())
  templateId Int
  template   Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String
  offsetDays Int // Tage relativ zum Veranstaltungstag (negativ = davor)
  sort       Int            @default(0)
  tasks      TemplateTask[]
}

model TemplateTask {
  id          Int                @id @default(autoincrement())
  templateId  Int
  template    Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  milestoneId Int?
  milestone   TemplateMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title       String
  description String?
  offsetDays  Int
  sort        Int                @default(0)
  areaId      Int?
  area        TemplateArea?      @relation(fields: [areaId], references: [id], onDelete: SetNull)
}

model Event {
  id                 Int            @id @default(autoincrement())
  title              String
  date               DateTime // Kalendertag, UTC-Mitternacht
  location           String?
  description        String?
  status             String         @default("GEPLANT")
  published          Boolean        @default(false) // für Bewohner sichtbar
  templateId         Int?
  template           Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  lessonsLearned     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  milestones         Milestone[]
  tasks              Task[]
  log                ActivityLog[]
  slots              HelperSlot[]
  rsvps              Rsvp[]
  budgetCents        Int? // Budgetrahmen für Ausgaben (Cent); leer = kein Rahmen
  approvalLimitCents Int            @default(0) // Ausgaben bis zu diesem Betrag brauchen keine Freigabe
  budgetItems        BudgetItem[]
  members            EventMember[]
  areas              Area[]
  attachments        Attachment[]
  group              Group?         @relation(fields: [groupId], references: [id])
  groupId            Int?
  schedule           ScheduleItem[]
  material           MaterialItem[]
}

model Milestone {
  id      Int      @id @default(autoincrement())
  eventId Int
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title   String
  dueDate DateTime
  sort    Int      @default(0)
  tasks   Task[]
}

model Task {
  id          Int        @id @default(autoincrement())
  eventId     Int
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  milestoneId Int?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title       String
  description String?
  dueDate     DateTime
  status      String     @default("OFFEN")
  assigneeId  Int?
  assignee    Person?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  areaId      Int?
  area        Area?      @relation(fields: [areaId], references: [id], onDelete: SetNull)
  sort        Int        @default(0)
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  eventId   Int?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

// Rolle einer Person bei einer einzelnen Veranstaltung (aktuell: FREIGEBER = gibt Ausgaben frei)
model EventMember {
  id       Int    @id @default(autoincrement())
  eventId  Int
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId Int
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  role     String @default("FREIGEBER")

  @@unique([eventId, personId, role])
}

// kind: AUSGABE | EINNAHME
// status Ausgabe: ENTWURF -> BEANTRAGT -> FREIGEGEBEN | ABGELEHNT -> BEZAHLT;  Einnahme: ENTWURF (erwartet) -> BEZAHLT (eingegangen)
model BudgetItem {
  id            Int          @id @default(autoincrement())
  eventId       Int
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind          String
  title         String
  category      String?
  plannedCents  Int
  actualCents   Int?
  status        String       @default("ENTWURF")
  note          String?
  requestedById Int?
  requestedBy   Person?      @relation("requested", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById   Int?
  decidedBy     Person?      @relation("decided", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  areaId        Int?
  area          Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  attachments   Attachment[]
}

model TemplateBudgetItem {
  id           Int           @id @default(autoincrement())
  templateId   Int
  template     Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  kind         String
  title        String
  category     String?
  plannedCents Int
  areaId       Int?
  area         TemplateArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
}

// Themengebiet einer Veranstaltung (z. B. Marketing, Technik, Verpflegung) mit optionaler Leitung
model Area {
  id          Int          @id @default(autoincrement())
  eventId     Int
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  leadId      Int?
  lead        Person?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sort        Int          @default(0)
  tasks       Task[]
  budgetItems BudgetItem[]

  @@unique([eventId, name])
}

model TemplateArea {
  id          Int                  @id @default(autoincrement())
  templateId  Int
  template    Template             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  sort        Int                  @default(0)
  tasks       TemplateTask[]
  budgetItems TemplateBudgetItem[]

  @@unique([templateId, name])
}

model Attachment {
  id           Int         @id @default(autoincrement())
  eventId      Int
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  budgetItemId Int?
  budgetItem   BudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  name         String // Originalname (nur zur Anzeige)
  storedName   String      @unique // Zufallsname auf der Platte
  mime         String
  size         Int
  visible      Boolean     @default(false) // für Bewohner sichtbar (nur bei veröffentlichter Veranstaltung)
  uploadedById Int?
  uploadedBy   Person?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
}

// Vorstand eines Vereins/einer Gruppe: darf Termine und Neuigkeiten des Vereins selbst pflegen
model GroupMember {
  id       Int    @id @default(autoincrement())
  groupId  Int
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  personId Int
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  role     String @default("VORSTAND")

  @@unique([groupId, personId])
}

// Schwarzes Brett + Fundbüro.  category: ALLGEMEIN | MITFAHREN | LEIHEN | HILFE | FUNDBUERO
// kind: BIETE | SUCHE  (Fundbüro: BIETE = gefunden, SUCHE = verloren)
model BoardPost {
  id         Int       @id @default(autoincrement())
  authorId   Int
  author     Person    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category   String
  kind       String
  title      String
  body       String
  contact    String? // freiwillig, vom Autor selbst eingetragen
  status     String    @default("OFFEN") // OFFEN | ERLEDIGT
  reportedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  photos     Photo[]
}

// Anliegen/Mängel an die Dorfgemeinschaft bzw. Gemeinde
// category: STRASSE | BELEUCHTUNG | MUELL | SPIELPLATZ | GRUENFLAECHE | SONSTIGES
// status: NEU | IN_BEARBEITUNG | WEITERGELEITET | ERLEDIGT | ABGELEHNT
model Issue {
  id           Int       @id @default(autoincrement())
  authorId     Int
  author       Person    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category     String
  title        String
  description  String
  locationText String?
  lat          Float?
  lng          Float?
  isPublic     Boolean   @default(false)
  status       String    @default("NEU")
  response     String?
  forwardedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  photos       Photo[]
}

model Photo {
  id         Int        @id @default(autoincrement())
  storedName String     @unique
  postId     Int?
  post       BoardPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  issueId    Int?
  issue      Issue?     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
}

// Automatische Quelle für den Müllkalender: iCal-Abo-Adresse des Entsorgers (nur freigegebene Hosts, siehe src/lib/aws-waste.ts)
model WasteSource {
  id          Int         @id @default(autoincrement())
  name        String // z. B. "AWS Schaumburg – Dorfstr. 2, Haste"
  label       String? // wird an die Tonnenart angehängt, wenn es mehrere Bereiche gibt
  url         String
  lastSyncAt  DateTime?
  lastOk      Boolean     @default(true)
  lastMessage String?
  lastCount   Int         @default(0)
  createdAt   DateTime    @default(now())
  dates       WasteDate[]
}

// Umfrage/Abstimmung. closesOn = letzter Tag, an dem abgestimmt werden kann (UTC-Mitternacht); leer = offen bis manuell beendet
model Poll {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  multiple    Boolean      @default(false) // mehrere Antworten erlaubt
  closesOn    DateTime?
  closedAt    DateTime? // manuell beendet
  createdById Int?
  createdBy   Person?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  options     PollOption[]
  votes       PollVote[]
}

model PollOption {
  id     Int        @id @default(autoincrement())
  pollId Int
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  sort   Int        @default(0)
  votes  PollVote[]
}

// Stimme einer Person für eine Antwort (Ergebnisse werden nur als Summen angezeigt)
model PollVote {
  id        Int        @id @default(autoincrement())
  pollId    Int
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  Int
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  personId  Int
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([optionId, personId])
  @@index([pollId, personId])
}

// Reservierbares Gemeinschaftsgut: Raum (Dorfgemeinschaftshaus) oder Gerät (Bierzeltgarnituren, Pavillon …)
model Resource {
  id            Int       @id @default(autoincrement())
  name          String
  kind          String    @default("GERAET") // RAUM | GERAET
  description   String?
  handover      String? // Abholung/Schlüssel, z. B. "Schlüssel bei Familie Meier, Dorfstr. 5"
  needsApproval Boolean   @default(true) // false = Buchung sofort bestätigt
  active        Boolean   @default(true)
  sort          Int       @default(0)
  bookings      Booking[]
}

// Reservierung über ganze Kalendertage (UTC-Mitternacht), Uhrzeit nur als Freitext
// status: ANGEFRAGT | BESTAETIGT | ABGELEHNT | STORNIERT  (ANGEFRAGT und BESTAETIGT blockieren den Zeitraum)
model Booking {
  id          Int       @id @default(autoincrement())
  resourceId  Int
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  personId    Int
  person      Person    @relation("booker", fields: [personId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  timeText    String?
  purpose     String
  status      String    @default("ANGEFRAGT")
  note        String? // Antwort der Orga
  decidedById Int?
  decidedBy   Person?   @relation("bookingDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([resourceId, startDate])
}

// Helfer-Slot in einer Vorlage (wird bei neuen Veranstaltungen ohne Eintragungen übernommen)
model TemplateSlot {
  id          Int      @id @default(autoincrement())
  templateId  Int
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  timeText    String?
  description String?
  capacity    Int      @default(1)
  sort        Int      @default(0)
}

// Ablaufplan: dayOffset relativ zum Veranstaltungstag (−1 = Aufbau am Vortag), time/endTime als "HH:MM"
model ScheduleItem {
  id            Int     @id @default(autoincrement())
  eventId       Int
  event         Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dayOffset     Int     @default(0)
  time          String?
  endTime       String?
  title         String
  place         String?
  note          String?
  isPublic      Boolean @default(false) // erscheint für Bewohner als „Programm“
  responsibleId Int?
  responsible   Person? @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
}

model TemplateScheduleItem {
  id         Int      @id @default(autoincrement())
  templateId Int
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dayOffset  Int      @default(0)
  time       String?
  endTime    String?
  title      String
  place      String?
  note       String?
  isPublic   Boolean  @default(false)
}

// Material- und Einkaufsliste.  status: OFFEN | ORGANISIERT | VOR_ORT
model MaterialItem {
  id            Int     @id @default(autoincrement())
  eventId       Int
  event         Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title         String
  quantity      String? // frei, z. B. "10 Sets", "3 Kisten"
  source        String? // z. B. "eigenes Inventar", "kaufen", "leihen bei Feuerwehr"
  note          String?
  status        String  @default("OFFEN")
  sort          Int     @default(0)
  responsibleId Int?
  responsible   Person? @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
}

model TemplateMaterialItem {
  id         Int      @id @default(autoincrement())
  templateId Int
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String
  quantity   String?
  source     String?
  note       String?
  sort       Int      @default(0)
}

// Versammlung/Sitzung des Orga-Teams (nur Organisator/Admin). date = Kalendertag (UTC-Mitternacht), Zeiten als "HH:MM" (Ortszeit Berlin)
model Meeting {
  id             Int                 @id @default(autoincrement())
  title          String
  date           DateTime
  startTime      String
  endTime        String?
  location       String?
  invitationText String? // persönlicher Text in der Einladung
  chair          String? // Sitzungsleitung (Name als Text, bleibt im Protokoll erhalten)
  minuteTaker    String? // Protokoll
  guests         String? // Gäste ohne Konto
  generalNotes   String? // Verschiedenes / Allgemeines
  finalizedAt    DateTime? // Protokoll abgeschlossen = schreibgeschützt
  protocolSentAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  agenda         MeetingAgendaItem[]
  invitees       MeetingInvitee[]
  todos          MeetingTodo[]
}

model MeetingAgendaItem {
  id        Int           @id @default(autoincrement())
  meetingId Int
  meeting   Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sort      Int           @default(0)
  title     String
  notes     String? // Protokoll zum Punkt
  decision  String? // Beschluss
  todos     MeetingTodo[]
}

// Eingeladene Person. name wird beim Einladen festgehalten, damit Protokolle auch nach Kontolöschung vollständig bleiben.
// response: OFFEN | ZUGESAGT | ABGESAGT.  mailStatus: GESENDET | KEINE_ADRESSE | FEHLER | NICHT_KONFIGURIERT
model MeetingInvitee {
  id         Int       @id @default(autoincrement())
  meetingId  Int
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  personId   Int?
  person     Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  name       String
  response   String    @default("OFFEN")
  present    Boolean   @default(false)
  invitedAt  DateTime?
  mailStatus String?

  @@unique([meetingId, personId])
}

// To-do aus dem Protokoll
model MeetingTodo {
  id           Int                @id @default(autoincrement())
  meetingId    Int
  meeting      Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  agendaItemId Int?
  agendaItem   MeetingAgendaItem? @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)
  title        String
  assigneeId   Int?
  assignee     Person?            @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  done         Boolean            @default(false)
  createdAt    DateTime           @default(now())
}
