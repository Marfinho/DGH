generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Status als String (SQLite kennt keine Enums); Werte siehe src/lib/constants.ts
model Person {
  id             Int                @id @default(autoincrement())
  name           String
  email          String?            @unique
  phone          String?
  role           String             @default("BEWOHNER") // BEWOHNER | ORGANISATOR | ADMIN
  calToken       String?            @unique // geheimer Token für den iCal-Feed
  createdAt      DateTime           @default(now())
  lastLoginAt    DateTime?
  tasks          Task[]
  sessions       Session[]
  invites        Invite[]
  loginTokens    LoginToken[]
  signups        HelperSignup[]
  rsvps          Rsvp[]
  eventMembers   EventMember[]
  requestedItems BudgetItem[]       @relation("requested")
  decidedItems   BudgetItem[]       @relation("decided")
  pushSubs       PushSubscription[]
  newsPosts      NewsPost[]
  areas          Area[]
  attachments    Attachment[]
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  personId  Int
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Invite {
  id        Int       @id @default(autoincrement())
  codeHash  String    @unique
  personId  Int
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model LoginToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  personId  Int
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
}

model HelperSlot {
  id          Int            @id @default(autoincrement())
  eventId     Int
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  timeText    String? // z. B. "14:00–16:00"
  description String?
  capacity    Int            @default(1)
  signups     HelperSignup[]
}

model HelperSignup {
  id        Int        @id @default(autoincrement())
  slotId    Int
  slot      HelperSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  personId  Int
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([slotId, personId])
}

model Rsvp {
  id       Int    @id @default(autoincrement())
  eventId  Int
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId Int
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  status   String // JA | NEIN | VIELLEICHT
  guests   Int    @default(0)

  @@unique([eventId, personId])
}

model PushSubscription {
  id       Int    @id @default(autoincrement())
  personId Int
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String
}

model NewsPost {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  pinned      Boolean  @default(false)
  authorId    Int?
  author      Person?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime @default(now())
}

model Group {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  meetingInfo String? // z. B. "jeden 1. Dienstag, 19:30, Gemeindehaus"
  website     String?
  contacts    Contact[]
}

// Bewusst veröffentlichte Ansprechpartner (getrennt von Person/Login-Konten)
model Contact {
  id       Int     @id @default(autoincrement())
  name     String
  function String? // z. B. "Ortsvorsteher"
  phone    String?
  email    String?
  groupId  Int?
  group    Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  sort     Int     @default(0)
}

model WasteDate {
  id   Int      @id @default(autoincrement())
  type String // frei, z. B. Restmüll, Bio, Papier, Gelber Sack
  date DateTime

  @@unique([type, date])
}

model Template {
  id          Int                  @id @default(autoincrement())
  name        String
  description String?
  updatedAt   DateTime             @updatedAt
  milestones  TemplateMilestone[]
  tasks       TemplateTask[]
  events      Event[]
  budgetItems TemplateBudgetItem[]
  areas       TemplateArea[]
}

model TemplateMilestone {
  id         Int            @id @default(autoincrement())
  templateId Int
  template   Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String
  offsetDays Int // Tage relativ zum Veranstaltungstag (negativ = davor)
  sort       Int            @default(0)
  tasks      TemplateTask[]
}

model TemplateTask {
  id          Int                @id @default(autoincrement())
  templateId  Int
  template    Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  milestoneId Int?
  milestone   TemplateMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title       String
  description String?
  offsetDays  Int
  sort        Int                @default(0)
  areaId      Int?
  area        TemplateArea?      @relation(fields: [areaId], references: [id], onDelete: SetNull)
}

model Event {
  id                 Int           @id @default(autoincrement())
  title              String
  date               DateTime // Kalendertag, UTC-Mitternacht
  location           String?
  description        String?
  status             String        @default("GEPLANT")
  published          Boolean       @default(false) // für Bewohner sichtbar
  templateId         Int?
  template           Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  lessonsLearned     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  milestones         Milestone[]
  tasks              Task[]
  log                ActivityLog[]
  slots              HelperSlot[]
  rsvps              Rsvp[]
  budgetCents        Int? // Budgetrahmen für Ausgaben (Cent); leer = kein Rahmen
  approvalLimitCents Int           @default(0) // Ausgaben bis zu diesem Betrag brauchen keine Freigabe
  budgetItems        BudgetItem[]
  members            EventMember[]
  areas              Area[]
  attachments        Attachment[]
}

model Milestone {
  id      Int      @id @default(autoincrement())
  eventId Int
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title   String
  dueDate DateTime
  sort    Int      @default(0)
  tasks   Task[]
}

model Task {
  id          Int        @id @default(autoincrement())
  eventId     Int
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  milestoneId Int?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title       String
  description String?
  dueDate     DateTime
  status      String     @default("OFFEN")
  assigneeId  Int?
  assignee    Person?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  areaId      Int?
  area        Area?      @relation(fields: [areaId], references: [id], onDelete: SetNull)
  sort        Int        @default(0)
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  eventId   Int?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

// Rolle einer Person bei einer einzelnen Veranstaltung (aktuell: FREIGEBER = gibt Ausgaben frei)
model EventMember {
  id       Int    @id @default(autoincrement())
  eventId  Int
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId Int
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  role     String @default("FREIGEBER")

  @@unique([eventId, personId, role])
}

// kind: AUSGABE | EINNAHME
// status Ausgabe: ENTWURF -> BEANTRAGT -> FREIGEGEBEN | ABGELEHNT -> BEZAHLT;  Einnahme: ENTWURF (erwartet) -> BEZAHLT (eingegangen)
model BudgetItem {
  id            Int          @id @default(autoincrement())
  eventId       Int
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind          String
  title         String
  category      String?
  plannedCents  Int
  actualCents   Int?
  status        String       @default("ENTWURF")
  note          String?
  requestedById Int?
  requestedBy   Person?      @relation("requested", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById   Int?
  decidedBy     Person?      @relation("decided", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  areaId        Int?
  area          Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  attachments   Attachment[]
}

model TemplateBudgetItem {
  id           Int           @id @default(autoincrement())
  templateId   Int
  template     Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  kind         String
  title        String
  category     String?
  plannedCents Int
  areaId       Int?
  area         TemplateArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
}

// Themengebiet einer Veranstaltung (z. B. Marketing, Technik, Verpflegung) mit optionaler Leitung
model Area {
  id          Int          @id @default(autoincrement())
  eventId     Int
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  leadId      Int?
  lead        Person?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sort        Int          @default(0)
  tasks       Task[]
  budgetItems BudgetItem[]

  @@unique([eventId, name])
}

model TemplateArea {
  id          Int                  @id @default(autoincrement())
  templateId  Int
  template    Template             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  sort        Int                  @default(0)
  tasks       TemplateTask[]
  budgetItems TemplateBudgetItem[]

  @@unique([templateId, name])
}

model Attachment {
  id           Int         @id @default(autoincrement())
  eventId      Int
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  budgetItemId Int?
  budgetItem   BudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  name         String // Originalname (nur zur Anzeige)
  storedName   String      @unique // Zufallsname auf der Platte
  mime         String
  size         Int
  visible      Boolean     @default(false) // für Bewohner sichtbar (nur bei veröffentlichter Veranstaltung)
  uploadedById Int?
  uploadedBy   Person?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
}
